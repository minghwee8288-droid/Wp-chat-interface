# Config for scripts/backfill.mjs (the standalone local history importer).
# Copy to .env and fill in real values. NEVER commit .env.
#
# These are the SAME variables the live app uses. The backfill reuses the app's
# persistence layer, which talks to Supabase over HTTPS via @supabase/supabase-js
# — so it needs SUPABASE_URL + the service role key, NOT a raw Postgres
# DATABASE_URL. (A DATABASE_URL is not used by this script; see the notes at the
# top of scripts/backfill.mjs.)

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

WHAPI_TOKEN=your-whapi-token
WHAPI_API_URL=https://gate.whapi.cloud
BUSINESS_NUMBER=6580119456

# Optional: milliseconds between outbound Whapi calls (default 250 = ~4 req/s).
# Raise it if your plan's rate limit is tighter; the script also backs off on 429.
# BACKFILL_DELAY_MS=250
